{
    "name": "ruvelo/laravel-security-alerts",
    "description": "Tells you when a package your Laravel app runs becomes vulnerable, and when a known flaw starts being exploited in the wild. Packagist, OSV and CISA KEV, no keys.",
    "keywords": [
        "laravel",
        "security",
        "vulnerabilities",
        "advisories",
        "composer-audit",
        "npm-audit",
        "cisa-kev",
        "osv",
        "notifications",
        "pulse",
        "health"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://ruvelo.github.io/laravel-security-alerts/",
    "authors": [
        {
            "name": "François Bultez",
            "homepage": "https://github.com/francoisbultez",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.4",
        "laravel/framework": "^12.4.1|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/mcp": "^1.0",
        "laravel/pint": "^1.32",
        "laravel/pulse": "^1.4",
        "laravel/slack-notification-channel": "^3.5",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "spatie/laravel-health": "^1.34"
    },
    "suggest": {
        "laravel/slack-notification-channel": "Sends alerts to a Slack webhook (^3.5)",
        "laravel/pulse": "Shows open alerts on a Pulse card (^1.4)",
        "spatie/laravel-health": "Adds a health check that fails on exploited vulnerabilities (^1.34)",
        "laravel/mcp": "Lets AI agents list open alerts over MCP (^1.0)"
    },
    "conflict": {
        "laravel/mcp": "<1.0"
    },
    "autoload": {
        "psr-4": {
            "Ruvelo\\SecurityAlerts\\": "src/",
            "Ruvelo\\SecurityAlerts\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruvelo\\SecurityAlerts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ruvelo\\SecurityAlerts\\SecurityAlertsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "demo": "php demo/build.php build/site && cp -r art build/site/art && echo 'Serve it: php -S 127.0.0.1:8000 -t build, then open /site/'"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/Ruvelo/laravel-security-alerts/issues",
        "source": "https://github.com/Ruvelo/laravel-security-alerts"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "lint": "Check code style",
        "format": "Fix code style",
        "analyse": "Run static analysis",
        "check": "Lint, analyse and test: what CI runs",
        "demo": "Build the static demo site into build/"
    }
}
